{
  "name": "proyecto-gym-os",
  "version": "0.1.0",
  "private": true,
  "description": "Entrega parcial de GYM-OS: inicio, registro, login y base de datos de autenticación.",
  "main": "index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "npm run build && node --watch index.js",
    "setup": "node config/setup.js",
    "db:init": "node config/init-db.js",
    "prestart": "npm run build",
    "build": "npm run build -w client"
  },
  "overrides": {
    "sequelize": {
      "uuid": "11.1.1"
    }
  },
  "dependencies": {
    "cookie-parser": "1.4.7",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "mysql2": "3.24.2",
    "sequelize": "6.37.8",
    "zod": "4.5.4"
  },
  "workspaces": [
    "client"
  ]
}
